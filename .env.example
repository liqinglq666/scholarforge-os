# Required for live reviews. Server-side only; never expose this as NEXT_PUBLIC_*.
DASHSCOPE_API_KEY=

# Optional OpenAI-compatible Alibaba Cloud Model Studio endpoint and model.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# Optional daily request-count circuit breaker, reset at UTC midnight.
# 0 disables this application-level budget. Use a positive value in production.
REVIEW_DAILY_REQUEST_BUDGET=0

# Optional account service. When omitted, ScholarForge remains fully usable in guest-local mode.
# The publishable key is sent only by the server routes in this implementation.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
