# Required for live Alibaba Cloud Model Studio reviews.
DASHSCOPE_API_KEY=

# Optional. The shared Beijing endpoint works for standard pay-as-you-go keys.
# For production, you can replace it with your workspace-specific base URL.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional model override.
DASHSCOPE_MODEL=qwen-plus
