# Required for live Alibaba Cloud Model Studio reviews.
DASHSCOPE_API_KEY=

# Optional. The shared Beijing endpoint works for standard pay-as-you-go keys.
# For production, you can replace it with your workspace-specific base URL.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional model override.
DASHSCOPE_MODEL=qwen-plus

# Optional but recommended for real user registration and login.
# Create a Supabase project and copy these values from Project Settings / API.
# Without them, ScholarForge OS falls back to clearly labeled local demo sessions.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
