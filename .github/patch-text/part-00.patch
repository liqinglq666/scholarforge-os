+
+/* v3 structural workflow */
+.project-portfolio { max-width: 1180px; margin-inline: auto; }
+.portfolio-heading { align-items: end; }
+.portfolio-actions { display: flex; align-items: center; gap: 10px; margin: 18px 0 24px; }
+.project-card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
+.project-card { display: flex; min-height: 260px; flex-direction: column; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 22px; background: var(--paper); box-shadow: var(--shadow-sm); }
+.project-card:hover { border-color: color-mix(in srgb, var(--brand) 45%, var(--line)); box-shadow: var(--shadow-md); transform: translateY(-2px); }
+.project-card-topline { display: flex; align-items: center; justify-content: space-between; gap: 14px; color: var(--muted); font-size: 11px; }
+.project-card h2 { margin: 28px 0 18px; font-size: 25px; line-height: 1.25; }
+.project-card h2 a { color: inherit; text-decoration: none; }
+.project-card dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin: auto 0 20px; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--line); }
+.project-card dl div { padding: 11px 8px; background: var(--canvas); text-align: center; }
+.project-card dt { color: var(--muted); font-size: 10px; }
+.project-card dd { margin: 3px 0 0; font-family: Georgia, serif; font-size: 20px; }
+.project-card-actions { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
+.project-card-actions .primary-link { min-height: 42px; }
+.portfolio-empty { margin-top: 18px; border: 1px dashed var(--line-strong); border-radius: var(--radius-lg); }
+.project-overview { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin: 18px 0 4px; }
+.project-overview article { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--radius-md); padding: 16px 18px; background: var(--paper); }
+.project-overview strong { font-family: Georgia, serif; font-size: 27px; }
+.project-overview span { margin-top: 4px; color: var(--muted); font-size: 11px; }
+.project-tool-nav { align-items: stretch; }
+.project-tool-nav .project-back-link { display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 12px; font-weight: 750; }
+.chapter-review-launcher { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 12px; margin-top: 14px; border: 1px solid #bad0c7; border-radius: var(--radius-md); padding: 14px; background: var(--brand-soft); }
+.chapter-review-launcher label > span { color: var(--brand-dark); }
+.chapter-review-launcher button { min-height: 46px; }
+
+.quick-review-setup { max-width: 980px; margin-inline: auto; }
+.quick-review-heading { padding-bottom: 8px; }
+.quick-review-panel { padding: clamp(20px, 4vw, 34px); }
+.quick-task-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 16px; }
+.quick-task-heading h2 { margin: 5px 0 0; font-size: 25px; }
+.quick-task-heading > span { max-width: 420px; color: var(--muted); font-size: 12px; text-align: right; }
+.quick-task-switcher { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
+.quick-task-switcher label { position: relative; display: flex; min-height: 54px; align-items: center; justify-content: center; border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 10px 14px; background: var(--canvas); cursor: pointer; }
+.quick-task-switcher label.selected { border-color: var(--brand); background: var(--brand-soft); color: var(--brand-dark); box-shadow: inset 0 0 0 1px var(--brand); }
+.quick-task-switcher input { position: absolute; opacity: 0; pointer-events: none; }
+.quick-source { margin-top: 24px; }
+.quick-source textarea { min-height: 360px; }
+.quick-review-submit { position: sticky; z-index: 10; bottom: 14px; display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 18px; border: 1px solid var(--line-strong); border-radius: var(--radius-md); padding: 14px 16px; background: rgba(255,254,250,0.96); box-shadow: var(--shadow-md); backdrop-filter: blur(12px); }
+.quick-review-submit > div { display: flex; flex-direction: column; }
+.quick-review-submit span { color: var(--muted); font-size: 12px; }
+.progressive-panel { padding: 0; overflow: hidden; }
+.progressive-panel > summary { display: flex; min-height: 72px; align-items: center; justify-content: space-between; padding: 16px 20px; cursor: pointer; list-style: none; }
+.progressive-panel > summary::-webkit-details-marker { display: none; }
+.progressive-panel > summary::after { content: '+'; display: grid; width: 30px; height: 30px; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--brand); font-size: 20px; }
+.progressive-panel[open] > summary::after { content: '−'; }
+.progressive-panel > summary span { display: flex; flex-direction: column; }
+.progressive-panel > summary small { margin-top: 3px; color: var(--muted); }
+.progressive-content { border-top: 1px solid var(--line); padding: 22px; }
+.advanced-terms { margin-top: 24px; border-top: 1px solid var(--line); padding-top: 20px; }
+.advanced-terms > div:first-child { display: flex; flex-direction: column; margin-bottom: 12px; }
+.advanced-terms > div:first-child span { color: var(--muted); font-size: 12px; }
+
+@media (max-width: 900px) {
+  .project-card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .project-overview { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .project-tool-nav { overflow-x: auto; }
+  .project-tool-nav > a { min-width: 150px; }
+}
+
+@media (max-width: 640px) {
+  .portfolio-actions, .quick-task-heading, .quick-review-submit { align-items: stretch; flex-direction: column; }
+  .portfolio-actions > *, .quick-review-submit button { width: 100%; }
+  .project-card-grid, .project-overview, .quick-task-switcher { grid-template-columns: 1fr; }
+  .project-card { min-height: 230px; }
+  .project-card-topline { align-items: flex-start; flex-direction: column; gap: 3px; }
+  .chapter-review-launcher { grid-template-columns: 1fr; }
+  .chapter-review-launcher button { width: 100%; }
+  .quick-task-heading > span { text-align: left; }
+  .quick-source textarea { min-height: 300px; }
+  .quick-review-submit { position: static; }
+  .progressive-content { padding: 18px 15px; }
+}
+.portfolio-limit { margin: 12px 0 0; border-left: 3px solid var(--minor); padding: 10px 13px; background: var(--minor-soft); color: var(--muted); font-size: 12px; }
